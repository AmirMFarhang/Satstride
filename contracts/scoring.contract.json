        "findings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "prefunded_inflow",
                  "circular_flow",
                  "income_is_loan",
                  "new_payer",
                  "irregular_genuine",
                  "injection_attempt",
                  "fan_in_burst",
                  "pass_through"

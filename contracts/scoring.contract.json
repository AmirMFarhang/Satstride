        "income_band": {
          "type": "string",
          "pattern": "^(not_assessed|(0|[1-9][0-9]{0,2}(,[0-9]{3})*)\u2013[1-9][0-9]{0,2}(,[0-9]{3})* USDT/month)$"
        },
        "checks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",

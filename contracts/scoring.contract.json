            },
            "required": [
              "type"
            ]
          }
        },
        "lender_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "borrower_pk": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lender_pk": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "purpose_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bundle_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"

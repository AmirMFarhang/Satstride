# Generated by `npx expo prebuild --platform android`: never committed (Continuous Native Generation)
/android/
/ios/
/.expo/
/dist/
node_modules/
# Generated by wdk-worklet-bundler (postinstall): regenerated on every install
/.wdk/
/.wdk-bundle/
# The local demo signing keystore and its passwords: never committed
/keystore/
*.jks
*.keystore
keystore.properties
# Built APKs, recordings, device captures
*.apk
*.aab
*.mp4
/captures/

{
  "name": "passbook-mobile",
  "version": "0.9.10",
  "private": true,
  "description": "Satstride on the phone: the borrower's wallet, keys and agent live on the device (WDK in a Bare worklet). Test coins only; sideloaded, never published.",
  "main": "index.ts",
  "scripts": {
    "setup": "bash scripts/fetch-native.sh && npm run laptop-native && wdk-worklet-bundler generate",
    "bundle": "wdk-worklet-bundler generate",
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android --no-install",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "tsx --test __tests__/*.test.ts",
    "check": "npm run typecheck && npm run laptop-native && npm test",
    "keystore": "bash scripts/make-keystore.sh",
    "apk": "bash scripts/build-apk.sh",
    "test:regtest": "tsx --test --test-concurrency=1 __tests__/regtest/*.test.ts",
    "issuer": "tsx infra/issuer.ts",
    "laptop-native": "npm rebuild @utexo/rgb-lib-linux-x64 --ignore-scripts=false",
    "materials": "tsx scripts/run-materials.ts"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "2.0.0",
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "0.4.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "@tanstack/react-query": "5.101.4",
    "@tetherto/wdk": "1.0.0-beta.19",
    "@tetherto/wdk-react-native-core": "1.0.0-beta.21",
    "@tetherto/wdk-wallet-btc": "1.0.0-beta.17",
    "@utexo/rgb-lib-bare": "0.3.0-beta.18",
    "bare-node-runtime": "1.5.0",
    "bitcoinjs-lib": "7.0.4",
    "bufferutil": "4.1.0",
    "expo": "55.0.31",
    "expo-build-properties": "55.0.18",
    "expo-clipboard": "55.0.17",
    "expo-crypto": "55.0.19",
    "expo-file-system": "55.0.26",
    "expo-font": "55.0.8",
    "expo-keep-awake": "55.0.8",
    "expo-local-authentication": "55.0.18",
    "expo-screen-capture": "55.0.18",
    "expo-status-bar": "55.0.6",
    "nostr-tools": "2.25.2",
    "passbook-worklet": "file:worklet",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-bare-kit": "0.16.0",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.15.3",
    "utf-8-validate": "6.0.6"
  },
  "devDependencies": {
    "@tetherto/wdk-worklet-bundler": "1.0.0-beta.15",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@utexo/rgb-lib": "0.3.0-beta.8",
    "babel-preset-expo": "55.0.24",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "expo-crypto": "55.0.19"
  },
  "license": "Apache-2.0"
}

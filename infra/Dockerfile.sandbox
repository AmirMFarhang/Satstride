# The sandbox image. Only the sandbox entrypoint and its dependencies.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm i --no-save tsx@4
COPY tsconfig.json ./
# the scoring contract: the sandbox checks consent receipts against it
COPY contracts ./contracts
COPY src ./src
USER node
EXPOSE 4180
CMD ["npx", "tsx", "src/sandbox/main.ts"]
